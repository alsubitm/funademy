generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Instructor {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  authVersion  Int      @default(1)
  createdAt    DateTime @default(now())
  assignments  InstructorAssignment[]
  notes        InstructorNote[]

  @@map("ye_instructors")
}

model InstructorAssignment {
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  instructorId Int
  courseRun    CourseRun  @relation(fields: [courseRunId], references: [id], onDelete: Cascade)
  courseRunId  Int

  @@id([instructorId, courseRunId])
  @@map("ye_instructor_assignments")
}

model InstructorNote {
  id           Int          @id @default(autoincrement())
  instructor   Instructor   @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  instructorId Int
  session      ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId    Int
  text         String
  updatedAt    DateTime     @updatedAt

  @@unique([instructorId, sessionId])
  @@map("ye_instructor_notes")
}

model Program {
  id            Int            @id @default(autoincrement())
  slug          String         @unique
  kitCode       String // KIT-01 ... KIT-06
  nameEn        String
  nameAr        String
  ageMin        Int
  ageMax        Int
  format        Format
  color         String // hex from the brand system
  level         Int // 1-5 level meter
  taglineEn     String
  taglineAr     String
  descEn        String
  descAr        String
  buildsEn      String[] // what kids build
  buildsAr      String[]
  termsEn       String[] // term structure lines
  termsAr       String[]
  coverImageUrl String?
  position      Int            @default(0)
  slots         ScheduleSlot[]
  bookings      Booking[]
  courseRuns    CourseRun[]
  skills        Skill[]

  @@map("ye_programs")
}

enum Format {
  online
  in_person

  @@map("ye_format")
}

model ScheduleSlot {
  id        Int       @id @default(autoincrement())
  program   Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId Int
  weekday   Int // 0=Sunday ... 6=Saturday
  time      String // "17:00"
  format    Format
  location  String? // e.g. "Al Yasmin partner school" for in-person
  capacity  Int       @default(12)
  seatsLeft Int       @default(12)
  active    Boolean   @default(true)
  bookings  Booking[]

  @@map("ye_schedule_slots")
}

model Booking {
  id               Int             @id @default(autoincrement())
  program          Program         @relation(fields: [programId], references: [id])
  programId        Int
  slot             ScheduleSlot    @relation(fields: [slotId], references: [id])
  slotId           Int
  parentName       String
  phone            String
  childFirstName   String
  childBirthYear   Int
  neighborhood     String // legacy field — always "riyadh" (city-level only)
  status           BookingStatus   @default(new)
  email            String?
  contactChannel   ContactChannel  @default(whatsapp)
  contactConsentAt DateTime?
  trialStartsAt    DateTime?
  reminderAt       DateTime?
  followUpAt       DateTime?
  assignedTo       String          @default("فريق القبول")
  trialAttendance  TrialAttendance @default(pending)
  attendedAt       DateTime?
  createdAt        DateTime        @default(now())
  communications   TrialCommunication[]
  conversionItem   PaymentItem?    @relation("TrialConversion")

  @@index([trialStartsAt])
  @@index([followUpAt])
  @@map("ye_bookings")
}

enum TrialCommunicationKind {
  reminder
  follow_up

  @@map("ye_trial_communication_kind")
}

enum TrialCommunicationStatus {
  pending
  sending
  sent
  failed

  @@map("ye_trial_communication_status")
}

model TrialCommunication {
  id        Int                      @id @default(autoincrement())
  booking   Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId Int
  kind      TrialCommunicationKind
  dueAt     DateTime
  status    TrialCommunicationStatus @default(pending)
  attempts  Int                      @default(0)
  claimedAt DateTime?
  claimToken String?
  sentAt    DateTime?
  lastError String?
  createdAt DateTime                 @default(now())

  @@unique([bookingId, kind])
  @@index([status, dueAt])
  @@map("ye_trial_communications")
}

enum BookingStatus {
  new
  contacted
  enrolled

  @@map("ye_booking_status")
}

enum ContactChannel {
  whatsapp
  email
  phone

  @@map("ye_contact_channel")
}

enum TrialAttendance {
  pending
  present
  absent

  @@map("ye_trial_attendance")
}

// ————————————————————————— Phase 1: Families & Students —————————————————————————

model Family {
  id                Int                @id @default(autoincrement())
  phone             String             @unique // normalized +9665XXXXXXXX
  parentName        String
  email             String?
  locale            String             @default("ar")
  createdAt         DateTime           @default(now())
  students          Student[]
  payments          Payment[]
  lrnChildren       LrnChild[]
  chatConversations ChatConversation[]
  chatActions       ChatActionAudit[]

  @@map("ye_families")
}

// ————————————————————— Family support chat (Task 166) —————————————————————

enum ChatRole {
  user
  assistant
  system

  @@map("ye_chat_role")
}

enum ChatConversationStatus {
  open
  closed

  @@map("ye_chat_conversation_status")
}

enum ChatActionKind {
  request_makeup
  book_consultation
  book_trial

  @@map("ye_chat_action_kind")
}

enum ChatActionStatus {
  prepared
  confirmed
  executing
  succeeded
  failed
  expired

  @@map("ye_chat_action_status")
}

model ChatConversation {
  id               String            @id @default(cuid())
  family           Family?           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId         Int?
  visitorTokenHash String?
  title            String?
  locale           String            @default("ar")
  status           ChatConversationStatus @default(open)
  contactMethod    String?
  contactValue     String?
  consentAt        DateTime
  consentVersion   String            @default("chat-v1")
  familyVerifiedAt DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  expiresAt        DateTime
  messages         ChatMessage[]
  escalations      ChatEscalation[]
  actions          ChatActionAudit[]

  @@index([familyId, updatedAt])
  @@index([visitorTokenHash, updatedAt])
  @@index([expiresAt])
  @@map("ye_chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           ChatRole
  content        String
  sourceRefs     Json?
  providerId     String?
  idempotencyKey String?
  createdAt      DateTime         @default(now())
  expiresAt      DateTime

  @@unique([conversationId, idempotencyKey])
  @@index([conversationId, createdAt])
  @@index([expiresAt])
  @@map("ye_chat_messages")
}

model ChatEscalation {
  id             String           @id @default(cuid())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  reason         String
  summary        String?
  status         String           @default("open")
  assignedTo     String?
  contactMethod  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  resolvedAt     DateTime?
  expiresAt      DateTime

  @@index([conversationId, createdAt])
  @@index([status, createdAt])
  @@index([expiresAt])
  @@map("ye_chat_escalations")
}

model ChatAudit {
  id             String           @id @default(cuid())
  conversationId String
  familyId       Int?
  event          String
  detail         Json?
  createdAt      DateTime         @default(now())
  expiresAt      DateTime

  @@index([conversationId, createdAt])
  @@index([expiresAt])
  @@map("ye_chat_audit")
}

// Append-only audit for chat-originated actions. Payloads contain only the
// minimum validated fields needed to execute an action and never payment data.
model ChatActionAudit {
  id             String           @id @default(cuid())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  family         Family?          @relation(fields: [familyId], references: [id], onDelete: SetNull)
  familyId       Int?
  kind           ChatActionKind
  status         ChatActionStatus @default(prepared)
  payload        Json
  result         Json?
  errorCode      String?
  idempotencyKey String           @unique
  preparedAt     DateTime         @default(now())
  confirmedAt    DateTime?
  executionStartedAt DateTime?
  executionAttempts Int              @default(0)
  executedAt     DateTime?
  updatedAt      DateTime         @default(now()) @updatedAt
  expiresAt      DateTime

  @@index([conversationId, preparedAt])
  @@index([familyId, preparedAt])
  @@index([expiresAt])
  @@map("ye_chat_action_audit")
}

model Student {
  id             Int             @id @default(autoincrement())
  family         Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId       Int
  firstName      String
  birthYear      Int
  // Saudi national ID / iqama (10 digits, starts 1 or 2) — the child's
  // learner identity for NELC live-class attendance statements. Optional:
  // without it attendance is never reported. Unique across all students.
  nationalId     String?         @unique
  createdAt      DateTime        @default(now())
  enrollments    Enrollment[]
  attendance     Attendance[]
  skills         StudentSkill[]
  badges         StudentBadge[]
  bricks         WatanBrick[]
  makeupRequests MakeupRequest[]

  @@index([familyId])
  @@map("ye_students")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  // Delivery outcome of the provider send: null = no real provider call
  // (dev devCode path) or unknown; false = provider rejected/errored.
  // Lets the admin dashboard surface recent sms_send_failed counts.
  delivered Boolean?
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@map("ye_otp_codes")
}

// Dedup state for out-of-band admin alerts (e.g. low SMS balance): one row
// per alert key, sentAt = last time the alert was actually dispatched.
// Claimed atomically (INSERT ... ON CONFLICT ... WHERE) so concurrent
// requests can never double-send within the cooldown window.
model AdminAlert {
  key    String   @id
  sentAt DateTime @default(now()) @map("sent_at")

  @@map("ye_admin_alerts")
}

// ————————————————————— Phase 1: Course Runs, Sessions, Enrollment —————————————————————

model CourseRun {
  id              Int            @id @default(autoincrement())
  program         Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId       Int
  titleAr         String? // optional label e.g. «دفعة سبتمبر»
  titleEn         String?
  startDate       DateTime
  endDate         DateTime
  weekday         Int // 0=Sunday ... 6=Saturday
  time            String // "17:00"
  format          Format
  location        String?
  capacity        Int            @default(12)
  seatsLeft       Int            @default(12)
  monthlyPriceSar Int            @default(1380)
  meetingUrl      String? // run-level meeting link for online runs (Zoom/Meet)
  active          Boolean        @default(true)
  sessions        ClassSession[]
  enrollments     Enrollment[]
  instructorAssignments InstructorAssignment[]

  @@index([programId, active])
  @@map("ye_course_runs")
}

model ClassSession {
  id             Int             @id @default(autoincrement())
  courseRun      CourseRun       @relation(fields: [courseRunId], references: [id], onDelete: Cascade)
  courseRunId    Int
  date           DateTime
  status         SessionStatus   @default(scheduled)
  note           String?
  meetingUrl     String? // per-session override of courseRun.meetingUrl
  recordingUrl   String? // link to the class recording after the session
  attendance     Attendance[]
  instructorNotes InstructorNote[]
  makeupRequests MakeupRequest[] @relation("MissedSession")
  makeupsInto    MakeupRequest[] @relation("MakeupSession")

  @@index([courseRunId, date])
  @@map("ye_class_sessions")
}

enum SessionStatus {
  scheduled
  completed
  cancelled

  @@map("ye_session_status")
}

model Enrollment {
  id              Int              @id @default(autoincrement())
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId       Int
  courseRun       CourseRun        @relation(fields: [courseRunId], references: [id], onDelete: Cascade)
  courseRunId     Int
  status          EnrollmentStatus @default(pending)
  monthlyPriceSar Int              @default(1380)
  discountPct     Int              @default(0) // 10 = sibling discount
  startedAt       DateTime?
  paidThrough     DateTime? // subscription covered until this date (exclusive)
  createdAt       DateTime         @default(now())
  paymentItems    PaymentItem[]

  @@unique([studentId, courseRunId])
  @@index([courseRunId, status])
  @@map("ye_enrollments")
}

enum EnrollmentStatus {
  pending
  active
  paused
  cancelled

  @@map("ye_enrollment_status")
}

// ————————————————————————— Payments & Receipts —————————————————————————

model Payment {
  id          Int             @id @default(autoincrement())
  family      Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId    Int
  kind        PaymentKind
  provider    String // moyasar_mada | moyasar_applepay | moyasar_stcpay | tamara
  reference   String // provider reference (SIM-* while simulated)
  status      PaymentTxStatus @default(paid)
  subtotalSar Int
  discountSar Int             @default(0)
  totalSar    Int
  simulated   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  items       PaymentItem[]

  @@index([familyId, createdAt])
  @@map("ye_payments")
}

model PaymentItem {
  id           Int         @id @default(autoincrement())
  payment      Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId    Int
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  enrollmentId Int?
  studentName  String // snapshot for receipts even if student is deleted
  programAr    String
  programEn    String
  periodStart  DateTime // month covered by this line
  periodEnd    DateTime
  baseSar      Int
  discountPct  Int         @default(0)
  totalSar     Int
  trialBooking   Booking? @relation("TrialConversion", fields: [trialBookingId], references: [id], onDelete: SetNull)
  trialBookingId Int?     @unique

  @@index([paymentId])
  @@map("ye_payment_items")
}

enum PaymentKind {
  enrollment
  renewal

  @@map("ye_payment_kind")
}

enum PaymentTxStatus {
  initiated // created, awaiting provider confirmation (redirect/3DS in progress)
  paid
  failed // provider confirmed decline/expiry — seats released, terminal
  expired // our timeout fired, seats released — still reconcilable if provider later settles
  refunding // admin refund claimed — provider call in flight (prevents duplicate provider refunds)
  refunded

  @@map("ye_payment_tx_status")
}

model Attendance {
  id        Int              @id @default(autoincrement())
  session   ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId Int
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId Int
  status    AttendanceStatus
  note      String?
  markedAt  DateTime         @default(now())

  // The enrollment is derived (student × session.courseRun) rather than stored,
  // so attendance can never contradict the enrollment it belongs to.
  @@unique([sessionId, studentId])
  @@map("ye_attendance")
}

// A parent's request to make up a session the child missed.
// Uniqueness per (student, session) so a family can't spam duplicates;
// admin approves/rejects, and the decision (plus adminNote) is what the
// parent sees in the portal — no separate notification table needed yet.
model MakeupRequest {
  id              Int           @id @default(autoincrement())
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId       Int
  session         ClassSession  @relation("MissedSession", fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId       Int
  status          MakeupStatus  @default(pending)
  note            String? // parent note (≤300 chars, enforced in API)
  adminNote       String? // admin reply shown to the parent (e.g. proposed makeup date)
  // The concrete makeup session booked on approval — shows in the child's
  // upcoming sessions and adds the child to that session's attendance roster.
  makeupSession   ClassSession? @relation("MakeupSession", fields: [makeupSessionId], references: [id], onDelete: SetNull)
  makeupSessionId Int?
  createdAt       DateTime      @default(now())
  decidedAt       DateTime?

  @@unique([studentId, sessionId])
  @@index([status, createdAt])
  @@map("ye_makeup_requests")
}

enum MakeupStatus {
  pending
  approved
  rejected

  @@map("ye_makeup_status")
}

enum AttendanceStatus {
  present
  absent
  late
  excused

  @@map("ye_attendance_status")
}

// ————————————————————————— Phase 1: Skills & Badges —————————————————————————

model Skill {
  id        Int            @id @default(autoincrement())
  program   Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId Int
  code      String         @unique // e.g. "mech-01-gears"
  nameAr    String
  nameEn    String
  position  Int            @default(0)
  students  StudentSkill[]

  @@index([programId])
  @@map("ye_skills")
}

model StudentSkill {
  id        Int         @id @default(autoincrement())
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId Int
  skill     Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId   Int
  status    SkillStatus @default(in_progress)
  updatedAt DateTime    @updatedAt

  @@unique([studentId, skillId])
  @@map("ye_student_skills")
}

enum SkillStatus {
  in_progress
  mastered

  @@map("ye_skill_status")
}

model Badge {
  id       Int            @id @default(autoincrement())
  code     String         @unique // e.g. "first-build"
  nameAr   String
  nameEn   String
  descAr   String
  descEn   String
  iconKey  String         @default("star") // star | gear | rocket | crown | bolt | kite
  position Int            @default(0)
  students StudentBadge[]

  @@map("ye_badges")
}

model StudentBadge {
  id        Int      @id @default(autoincrement())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId Int
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  badgeId   Int
  awardedAt DateTime @default(now())

  @@unique([studentId, badgeId])
  @@map("ye_student_badges")
}

// ————————————————————————— Phase 1: Watan Bricks —————————————————————————

model WatanBrick {
  id         Int         @id @default(autoincrement())
  student    Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentId  Int?
  authorName String // child first name shown on the wall
  color      String // brand hex only
  message    String // short message (≤120 chars, enforced in API)
  status     BrickStatus @default(pending)
  createdAt  DateTime    @default(now())

  @@index([status, createdAt])
  @@map("ye_watan_bricks")
}

enum BrickStatus {
  pending
  approved
  rejected

  @@map("ye_brick_status")
}

model Testimonial {
  id        Int     @id @default(autoincrement())
  name      String // e.g. "Um Khalid"
  nameAr    String
  area      String // city (Riyadh)
  programEn String
  programAr String
  quoteEn   String
  quoteAr   String
  stars     Int     @default(5)
  published Boolean @default(true)
  position  Int     @default(0)

  @@map("ye_testimonials")
}

model FaqEntry {
  id         Int     @id @default(autoincrement())
  questionEn String
  questionAr String
  answerEn   String
  answerAr   String
  published  Boolean @default(true)
  position   Int     @default(0)

  @@map("ye_faqs")
}

model BrickEvent {
  id        Int      @id @default(autoincrement())
  ipHash    String
  amount    Int
  day       String // YYYY-MM-DD (Asia/Riyadh)
  createdAt DateTime @default(now())

  @@index([ipHash, day])
  @@map("ye_brick_events")
}

model ClickEvent {
  id    Int    @id @default(autoincrement())
  kind  String // e.g. "whatsapp"
  page  String
  day   String // YYYY-MM-DD
  count Int    @default(0)

  @@unique([kind, page, day])
  @@index([day])
  @@map("ye_click_events")
}

enum AppointmentKind {
  trial
  consult
}

enum AppointmentStatus {
  scheduled
  cancelled
}

model Appointment {
  id              Int               @id @default(autoincrement())
  kind            AppointmentKind
  parentName      String
  phone           String
  email           String?
  childFirstName  String?
  programId       Int?
  bookingId       Int?
  startsAt        DateTime
  durationMin     Int               @default(30)
  meetUrl         String?
  calendarEventId String?
  notes           String?
  // Atomic claim for consultation slots: ISO start time for scheduled
  // consults, null for trials/cancelled — unique so two requests can never
  // book the same consultation window.
  consultKey      String?           @unique
  status          AppointmentStatus @default(scheduled)
  createdAt       DateTime          @default(now())

  @@index([phone])
  @@index([startsAt])
  @@map("ye_appointments")
}

// Blog posts (migrated from Manara CMS). Arabic is required; English mirror
// fields are optional — public EN pages fall back to Arabic when absent.
model BlogPost {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  titleAr       String
  titleEn       String?
  excerptAr     String
  excerptEn     String?
  contentAr     String
  contentEn     String?
  coverEmoji    String   @default("📚")
  coverImageUrl String?
  published     Boolean  @default(true)
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([published, publishedAt])
  @@map("ye_blog_posts")
}

// ————————————————————————— Learning Platform —————————————————————————

enum LrnBand {
  explorers
  builders
  achievers
  graduates

  @@map("ye_lrn_band")
}

enum LrnStatus {
  draft
  published

  @@map("ye_lrn_status")
}

enum LrnVideoType {
  youtube
  vimeo
  mp4

  @@map("ye_lrn_video_type")
}

enum LrnExerciseType {
  multiple_choice
  matching
  fill_blank
  picture_select

  @@map("ye_lrn_exercise_type")
}

model LrnSubject {
  id       Int       @id @default(autoincrement())
  nameAr   String
  nameEn   String
  slug     String    @unique
  icon     String // emoji or icon key
  color    String // hex color
  position Int       @default(0)
  units    LrnUnit[]

  @@map("ye_lrn_subjects")
}

model LrnUnit {
  id        Int         @id @default(autoincrement())
  subject   LrnSubject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId Int
  band      LrnBand
  titleAr   String
  titleEn   String
  position  Int         @default(0)
  status    LrnStatus   @default(published)
  lessons   LrnLesson[]

  @@index([subjectId, band])
  @@map("ye_lrn_units")
}

model LrnLesson {
  id               Int                  @id @default(autoincrement())
  unit             LrnUnit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId           Int
  titleAr          String
  titleEn          String
  descAr           String?
  descEn           String?
  videoUrl         String?
  videoType        LrnVideoType         @default(youtube)
  videoLanguage    String               @default("unknown")
  videoUrlEn       String?
  videoTypeEn      LrnVideoType         @default(youtube)
  durationMinutes  Int                  @default(8)
  position         Int                  @default(0)
  status           LrnStatus            @default(published)
  isFreeSample     Boolean              @default(false)
  exercises        LrnExercise[]
  completions      LrnCompletion[]
  firstCompletions LrnFirstCompletion[]

  @@index([unitId])
  @@map("ye_lrn_lessons")
}

model LrnExercise {
  id            Int             @id @default(autoincrement())
  lesson        LrnLesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId      Int
  type          LrnExerciseType @default(multiple_choice)
  promptAr      String
  promptEn      String
  options       String[]
  optionsEn     String[]        @default([])
  correctAnswer String
  position      Int             @default(0)

  @@index([lessonId])
  @@map("ye_lrn_exercises")
}

/// Standalone kid profile for the learning platform (not tied to Student enrollment)
model LrnChild {
  id                Int                  @id @default(autoincrement())
  family            Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId          Int
  name              String
  avatar            String               @default("⭐")
  band              LrnBand              @default(explorers)
  pin               String // scrypt salt:hash
  // Saudi national ID / iqama of the CHILD (10 digits, starts 1 or 2) —
  // entered by the parent, used ONLY as the xAPI actor identity for NELC
  // production learning-record statements. null = no statements are sent
  // for this child. Unique when set: one learner identity per child.
  nationalId        String?              @unique
  xp                Int                  @default(0)
  streak            Int                  @default(0)
  lastActiveDate    String? // ISO date YYYY-MM-DD
  badges            String[]             @default([])
  dailyLimitMinutes Int?
  createdAt         DateTime             @default(now())
  completions       LrnCompletion[]
  firstCompletions  LrnFirstCompletion[]

  @@index([familyId])
  @@map("ye_lrn_children")
}

model LrnCompletion {
  id               Int       @id @default(autoincrement())
  child            LrnChild  @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId          Int
  lesson           LrnLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId         Int
  score            Float // 0-100
  timeSpentSeconds Int       @default(0)
  createdAt        DateTime  @default(now())

  @@index([childId, lessonId])
  @@map("ye_lrn_completions")
}

/// Durable first-completion claim — unique (childId, lessonId) ensures only
/// one row can be inserted; used atomically (createMany skipDuplicates in a
/// transaction) to determine whether XP/badges should be awarded.
model LrnFirstCompletion {
  id        Int       @id @default(autoincrement())
  child     LrnChild  @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId   Int
  lesson    LrnLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId  Int
  claimedAt DateTime  @default(now())

  @@unique([childId, lessonId])
  @@map("ye_lrn_first_completions")
}

/// Permanent audit of ADMIN corrections to a LOCKED child national ID
/// (task: a parent typo discovered after statements were sent to NELC).
/// The old NELC records are NOT deleted (the LRS never deletes — the wrong
/// ID stays "burned"); a fresh registered+progressed snapshot is queued
/// under the corrected ID. No child FK on purpose — audit rows must outlive
/// the child.
model LrnChildIdCorrection {
  id                Int      @id @default(autoincrement())
  childId           Int? // informational only — no FK, rows outlive the child
  childName         String
  oldNationalId     String
  newNationalId     String
  changedBy         String   @default("admin") // single-admin app; kept explicit for the audit trail
  supersededPending Int      @default(0) // pending outbox rows under the OLD ID cancelled at correction time
  snapshotQueued    Int      @default(0) // outbox rows queued under the NEW ID right after the correction
  createdAt         DateTime @default(now())

  @@map("ye_lrn_child_id_corrections")
}

// ————————————————————————— NELC xAPI / LRS —————————————————————————

// One row per xAPI statement sent (or attempted) to the NELC Learning Record
// Store — a permanent audit log reviewed from the admin «نيلك» tab. Statement
// UUIDs are freshly generated every run, so re-running the wizard's
// verification test is always safe.
model XapiStatement {
  id          Int      @id @default(autoincrement())
  runId       String // groups the statements of one journey run
  environment String // staging | production (NELC_LRS_ENV at send time)
  nationalId  String // test learner national ID (actor account.name)
  courseIri   String // activity/object IRI the journey was sent for
  verb        String // journey step key (registered … earned)
  statementId String // client-generated statement UUID sent to the LRS
  httpStatus  Int? // null = network error before any HTTP response
  response    String? // LRS response body (truncated)
  ok          Boolean  @default(false)
  // Who observed this outcome. "server" = this server sent the statement and
  // saw the LRS response itself. "browser" = reported back by the admin's
  // browser relay — NOT verified server-side (NELC geo-blocks our egress, so
  // the server cannot confirm; NELC's own wizard check is the authority).
  source      String   @default("server")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("ye_xapi_statements")
}

// One server-prepared browser-relay journey run. `record` only accepts
// results whose runId + ordered statement IDs exactly match an unconsumed,
// unexpired row, then consumes it atomically (one-time) — so the permanent
// audit log cannot be fabricated by replaying or inventing payloads.
model XapiPreparedRun {
  id          Int      @id @default(autoincrement())
  runId       String   @unique
  environment String // staging | production at prepare time
  nationalId  String
  courseIri   String
  steps       Json // ordered [{ key, statementId }] of the prepared journey
  consumed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
  @@map("ye_xapi_prepared_runs")
}

// ——————————————— NELC production outbox (real learner events) ———————————————

// One REAL learner xAPI statement queued for NELC's PRODUCTION LRS. Rows are
// enqueued right after a real learning event commits (registered / completed
// lesson / completed unit / progressed / completed course) with the full
// statement JSON built at event time, so delivery can lag without losing the
// real timestamps. status: pending → sent. `attempts` counts SERVER delivery
// tries only (NELC's WAF geo-blocks our datacenter egress, so server sends
// may never succeed; the admin browser-relay flush in the NELC tab is the
// guaranteed path and ignores the attempts cap). No child FK on purpose —
// delivery audit rows must survive child deletion.
model XapiOutbox {
  id             Int       @id @default(autoincrement())
  childId        Int? // informational only — no FK, rows outlive the child (learning-platform events)
  studentId      Int? // informational only — no FK (live-class attendance events)
  nationalId     String // actor identity (child's national ID at event time)
  courseIri      String // course IRI the statement targets (subject or live course run)
  verb           String // registered | completed_lesson | completed_unit | progressed | completed_course | attended
  statementId    String    @unique // client-generated xAPI statement UUID
  statement      Json // full xAPI statement built at event time
  status         String    @default("pending") // pending | sending (server claim in flight) | sent | voided (admin skip) | superseded (ID corrected before delivery)
  attempts       Int       @default(0) // server send tries (browser relay ignores the cap)
  claimedAt      DateTime? // when the server flush claimed the row (stale `sending` rows revert to pending)
  lastError      String? // last delivery error body/marker (truncated)
  lastHttpStatus Int? // last delivery HTTP status (null = network error)
  source         String? // who delivered it: server | browser (null while pending)
  // Admin skip of a permanently-rejected row (never a delete, never a fake
  // "sent"): who/why/when are recorded and the row stays visible forever.
  voidReason     String? // admin-entered reason (required when voiding)
  voidedBy       String? // who executed the void (admin)
  voidedAt       DateTime?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  @@index([status, id])
  @@index([childId])
  @@index([studentId])
  @@map("ye_xapi_outbox")
}

// One-time handshake for the admin browser-relay flush of the production
// outbox — same provenance pattern as XapiPreparedRun: `outbox_record` only
// accepts statement IDs handed out by an unconsumed, unexpired
// `outbox_prepare`, consumed atomically, so sent-marks always correspond to
// a flush THIS server prepared (no fabricated or replayed reports).
model XapiOutboxFlushRun {
  id           Int      @id @default(autoincrement())
  runId        String   @unique
  statementIds String[] // ordered statement UUIDs handed to the browser
  consumed     Boolean  @default(false)
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
  @@map("ye_xapi_outbox_flush_runs")
}

// ————————————————————————— Rate Limit (durable) —————————————————————————

// Durable sliding-window rate-limit counters for public booking endpoints.
// Persisted in the DB (not process memory) so limits survive server restarts
// and apply across multiple instances.
model RateLimitHit {
  id  Int      @id @default(autoincrement())
  key String
  at  DateTime @default(now())

  @@index([key, at])
  @@index([at])
  @@map("ye_rate_limit_hits")
}

// ————————— Shared campaign tables (pre-existing raw-SQL tables in public) —————————
// Declared so `prisma db push` never drops them; the watanona brick counter
// and legacy campaign site share these rows.

model CampaignCounter {
  key   String @id
  count Int    @default(0)

  @@map("campaign_counters")
}

model CampaignBrickEvent {
  id        Int      @id @default(autoincrement())
  key       String
  amount    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([key, createdAt])
  @@map("campaign_brick_events")
}
