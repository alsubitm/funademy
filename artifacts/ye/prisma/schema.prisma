generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["ye"]
}

model Program {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  kitCode     String // KIT-01 ... KIT-06
  nameEn      String
  nameAr      String
  ageMin      Int
  ageMax      Int
  format      Format
  color       String // hex from the brand system
  level       Int // 1-5 level meter
  taglineEn   String
  taglineAr   String
  descEn      String
  descAr      String
  buildsEn    String[] // what kids build
  buildsAr    String[]
  termsEn     String[] // term structure lines
  termsAr     String[]
  position    Int      @default(0)
  slots       ScheduleSlot[]
  bookings    Booking[]
  courseRuns  CourseRun[]
  skills      Skill[]

  @@map("ye_programs")
  @@schema("ye")
}

enum Format {
  online
  in_person

  @@map("ye_format")
  @@schema("ye")
}

model ScheduleSlot {
  id        Int      @id @default(autoincrement())
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId Int
  weekday   Int // 0=Sunday ... 6=Saturday
  time      String // "17:00"
  format    Format
  location  String? // e.g. "Al Yasmin partner school" for in-person
  capacity  Int      @default(12)
  seatsLeft Int      @default(12)
  active    Boolean  @default(true)
  bookings  Booking[]

  @@map("ye_schedule_slots")
  @@schema("ye")
}

model Booking {
  id             Int          @id @default(autoincrement())
  program        Program      @relation(fields: [programId], references: [id])
  programId      Int
  slot           ScheduleSlot @relation(fields: [slotId], references: [id])
  slotId         Int
  parentName     String
  phone          String
  childFirstName String
  childBirthYear Int
  neighborhood   String // legacy field — always "riyadh" (city-level only)
  status         BookingStatus @default(new)
  createdAt      DateTime     @default(now())

  @@map("ye_bookings")
  @@schema("ye")
}

enum BookingStatus {
  new
  contacted
  enrolled

  @@map("ye_booking_status")
  @@schema("ye")
}

// ————————————————————————— Phase 1: Families & Students —————————————————————————

model Family {
  id         Int       @id @default(autoincrement())
  phone      String    @unique // normalized +9665XXXXXXXX
  parentName String
  email      String?
  locale     String    @default("ar")
  createdAt  DateTime  @default(now())
  students      Student[]
  payments      Payment[]
  lrnChildren   LrnChild[]

  @@map("ye_families")
  @@schema("ye")
}

model Student {
  id          Int      @id @default(autoincrement())
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId    Int
  firstName   String
  birthYear   Int
  createdAt   DateTime @default(now())
  enrollments Enrollment[]
  attendance  Attendance[]
  skills      StudentSkill[]
  badges      StudentBadge[]
  bricks      WatanBrick[]
  makeupRequests MakeupRequest[]

  @@index([familyId])
  @@map("ye_students")
  @@schema("ye")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@map("ye_otp_codes")
  @@schema("ye")
}

// ————————————————————— Phase 1: Course Runs, Sessions, Enrollment —————————————————————

model CourseRun {
  id              Int            @id @default(autoincrement())
  program         Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId       Int
  titleAr         String? // optional label e.g. «دفعة سبتمبر»
  titleEn         String?
  startDate       DateTime
  endDate         DateTime
  weekday         Int // 0=Sunday ... 6=Saturday
  time            String // "17:00"
  format          Format
  location        String?
  capacity        Int            @default(12)
  seatsLeft       Int            @default(12)
  monthlyPriceSar Int            @default(1380)
  meetingUrl      String? // run-level meeting link for online runs (Zoom/Meet)
  active          Boolean        @default(true)
  sessions        ClassSession[]
  enrollments     Enrollment[]

  @@index([programId, active])
  @@map("ye_course_runs")
  @@schema("ye")
}

model ClassSession {
  id          Int           @id @default(autoincrement())
  courseRun   CourseRun     @relation(fields: [courseRunId], references: [id], onDelete: Cascade)
  courseRunId Int
  date        DateTime
  status      SessionStatus @default(scheduled)
  note        String?
  meetingUrl   String? // per-session override of courseRun.meetingUrl
  recordingUrl String? // link to the class recording after the session
  attendance  Attendance[]
  makeupRequests MakeupRequest[] @relation("MissedSession")
  makeupsInto    MakeupRequest[] @relation("MakeupSession")

  @@index([courseRunId, date])
  @@map("ye_class_sessions")
  @@schema("ye")
}

enum SessionStatus {
  scheduled
  completed
  cancelled

  @@map("ye_session_status")
  @@schema("ye")
}

model Enrollment {
  id              Int              @id @default(autoincrement())
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId       Int
  courseRun       CourseRun        @relation(fields: [courseRunId], references: [id], onDelete: Cascade)
  courseRunId     Int
  status          EnrollmentStatus @default(pending)
  monthlyPriceSar Int              @default(1380)
  discountPct     Int              @default(0) // 10 = sibling discount
  startedAt       DateTime?
  paidThrough     DateTime? // subscription covered until this date (exclusive)
  createdAt       DateTime         @default(now())
  paymentItems    PaymentItem[]

  @@unique([studentId, courseRunId])
  @@index([courseRunId, status])
  @@map("ye_enrollments")
  @@schema("ye")
}

enum EnrollmentStatus {
  pending
  active
  paused
  cancelled

  @@map("ye_enrollment_status")
  @@schema("ye")
}

// ————————————————————————— Payments & Receipts —————————————————————————

model Payment {
  id          Int           @id @default(autoincrement())
  family      Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId    Int
  kind        PaymentKind
  provider    String // moyasar_mada | moyasar_applepay | moyasar_stcpay | tamara
  reference   String // provider reference (SIM-* while simulated)
  status      PaymentTxStatus @default(paid)
  subtotalSar Int
  discountSar Int           @default(0)
  totalSar    Int
  simulated   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  items       PaymentItem[]

  @@index([familyId, createdAt])
  @@map("ye_payments")
  @@schema("ye")
}

model PaymentItem {
  id           Int         @id @default(autoincrement())
  payment      Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId    Int
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  enrollmentId Int?
  studentName  String // snapshot for receipts even if student is deleted
  programAr    String
  programEn    String
  periodStart  DateTime // month covered by this line
  periodEnd    DateTime
  baseSar      Int
  discountPct  Int         @default(0)
  totalSar     Int

  @@index([paymentId])
  @@map("ye_payment_items")
  @@schema("ye")
}

enum PaymentKind {
  enrollment
  renewal

  @@map("ye_payment_kind")
  @@schema("ye")
}

enum PaymentTxStatus {
  initiated // created, awaiting provider confirmation (redirect/3DS in progress)
  paid
  failed    // provider confirmed decline/expiry — seats released, terminal
  expired   // our timeout fired, seats released — still reconcilable if provider later settles
  refunding // admin refund claimed — provider call in flight (prevents duplicate provider refunds)
  refunded

  @@map("ye_payment_tx_status")
  @@schema("ye")
}

model Attendance {
  id        Int              @id @default(autoincrement())
  session   ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId Int
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId Int
  status    AttendanceStatus
  note      String?
  markedAt  DateTime         @default(now())

  // The enrollment is derived (student × session.courseRun) rather than stored,
  // so attendance can never contradict the enrollment it belongs to.
  @@unique([sessionId, studentId])
  @@map("ye_attendance")
  @@schema("ye")
}

// A parent's request to make up a session the child missed.
// Uniqueness per (student, session) so a family can't spam duplicates;
// admin approves/rejects, and the decision (plus adminNote) is what the
// parent sees in the portal — no separate notification table needed yet.
model MakeupRequest {
  id        Int          @id @default(autoincrement())
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId Int
  session   ClassSession @relation("MissedSession", fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId Int
  status    MakeupStatus @default(pending)
  note      String? // parent note (≤300 chars, enforced in API)
  adminNote String? // admin reply shown to the parent (e.g. proposed makeup date)
  // The concrete makeup session booked on approval — shows in the child's
  // upcoming sessions and adds the child to that session's attendance roster.
  makeupSession   ClassSession? @relation("MakeupSession", fields: [makeupSessionId], references: [id], onDelete: SetNull)
  makeupSessionId Int?
  createdAt DateTime     @default(now())
  decidedAt DateTime?

  @@unique([studentId, sessionId])
  @@index([status, createdAt])
  @@map("ye_makeup_requests")
  @@schema("ye")
}

enum MakeupStatus {
  pending
  approved
  rejected

  @@map("ye_makeup_status")
  @@schema("ye")
}

enum AttendanceStatus {
  present
  absent
  late
  excused

  @@map("ye_attendance_status")
  @@schema("ye")
}

// ————————————————————————— Phase 1: Skills & Badges —————————————————————————

model Skill {
  id        Int            @id @default(autoincrement())
  program   Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId Int
  code      String         @unique // e.g. "mech-01-gears"
  nameAr    String
  nameEn    String
  position  Int            @default(0)
  students  StudentSkill[]

  @@index([programId])
  @@map("ye_skills")
  @@schema("ye")
}

model StudentSkill {
  id        Int         @id @default(autoincrement())
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId Int
  skill     Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId   Int
  status    SkillStatus @default(in_progress)
  updatedAt DateTime    @updatedAt

  @@unique([studentId, skillId])
  @@map("ye_student_skills")
  @@schema("ye")
}

enum SkillStatus {
  in_progress
  mastered

  @@map("ye_skill_status")
  @@schema("ye")
}

model Badge {
  id       Int            @id @default(autoincrement())
  code     String         @unique // e.g. "first-build"
  nameAr   String
  nameEn   String
  descAr   String
  descEn   String
  iconKey  String         @default("star") // star | gear | rocket | crown | bolt | kite
  position Int            @default(0)
  students StudentBadge[]

  @@map("ye_badges")
  @@schema("ye")
}

model StudentBadge {
  id        Int      @id @default(autoincrement())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId Int
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  badgeId   Int
  awardedAt DateTime @default(now())

  @@unique([studentId, badgeId])
  @@map("ye_student_badges")
  @@schema("ye")
}

// ————————————————————————— Phase 1: Watan Bricks —————————————————————————

model WatanBrick {
  id         Int         @id @default(autoincrement())
  student    Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentId  Int?
  authorName String // child first name shown on the wall
  color      String // brand hex only
  message    String // short message (≤120 chars, enforced in API)
  status     BrickStatus @default(pending)
  createdAt  DateTime    @default(now())

  @@index([status, createdAt])
  @@map("ye_watan_bricks")
  @@schema("ye")
}

enum BrickStatus {
  pending
  approved
  rejected

  @@map("ye_brick_status")
  @@schema("ye")
}

model Testimonial {
  id        Int     @id @default(autoincrement())
  name      String // e.g. "Um Khalid"
  nameAr    String
  area      String // city (Riyadh)
  programEn String
  programAr String
  quoteEn   String
  quoteAr   String
  stars     Int     @default(5)
  published Boolean @default(true)
  position  Int     @default(0)

  @@map("ye_testimonials")
  @@schema("ye")
}

model FaqEntry {
  id        Int     @id @default(autoincrement())
  questionEn String
  questionAr String
  answerEn  String
  answerAr  String
  published Boolean @default(true)
  position  Int     @default(0)

  @@map("ye_faqs")
  @@schema("ye")
}

model BrickEvent {
  id        Int      @id @default(autoincrement())
  ipHash    String
  amount    Int
  day       String // YYYY-MM-DD (Asia/Riyadh)
  createdAt DateTime @default(now())

  @@index([ipHash, day])
  @@map("ye_brick_events")
  @@schema("ye")
}

model ClickEvent {
  id    Int    @id @default(autoincrement())
  kind  String // e.g. "whatsapp"
  page  String
  day   String // YYYY-MM-DD
  count Int    @default(0)

  @@unique([kind, page, day])
  @@map("ye_click_events")
  @@schema("ye")
}

enum AppointmentKind {
  trial
  consult

  @@schema("ye")
}

enum AppointmentStatus {
  scheduled
  cancelled

  @@schema("ye")
}

model Appointment {
  id              Int               @id @default(autoincrement())
  kind            AppointmentKind
  parentName      String
  phone           String
  email           String?
  childFirstName  String?
  programId       Int?
  bookingId       Int?
  startsAt        DateTime
  durationMin     Int               @default(30)
  meetUrl         String?
  calendarEventId String?
  notes           String?
  // Atomic claim for consultation slots: ISO start time for scheduled
  // consults, null for trials/cancelled — unique so two requests can never
  // book the same consultation window.
  consultKey      String?           @unique
  status          AppointmentStatus @default(scheduled)
  createdAt       DateTime          @default(now())

  @@index([phone])
  @@index([startsAt])
  @@map("ye_appointments")
  @@schema("ye")
}

// Blog posts (migrated from Manara CMS). Arabic is required; English mirror
// fields are optional — public EN pages fall back to Arabic when absent.
model BlogPost {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  titleAr     String
  titleEn     String?
  excerptAr   String
  excerptEn   String?
  contentAr   String
  contentEn   String?
  coverEmoji  String   @default("📚")
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([published, publishedAt])
  @@map("ye_blog_posts")
  @@schema("ye")
}

// ————————————————————————— Learning Platform —————————————————————————

enum LrnBand {
  explorers
  builders
  achievers
  graduates

  @@map("ye_lrn_band")
  @@schema("ye")
}

enum LrnStatus {
  draft
  published

  @@map("ye_lrn_status")
  @@schema("ye")
}

enum LrnVideoType {
  youtube
  vimeo
  mp4

  @@map("ye_lrn_video_type")
  @@schema("ye")
}

enum LrnExerciseType {
  multiple_choice
  matching
  fill_blank
  picture_select

  @@map("ye_lrn_exercise_type")
  @@schema("ye")
}

model LrnSubject {
  id       Int         @id @default(autoincrement())
  nameAr   String
  nameEn   String
  slug     String      @unique
  icon     String      // emoji or icon key
  color    String      // hex color
  position Int         @default(0)
  units    LrnUnit[]

  @@map("ye_lrn_subjects")
  @@schema("ye")
}

model LrnUnit {
  id        Int        @id @default(autoincrement())
  subject   LrnSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId Int
  band      LrnBand
  titleAr   String
  titleEn   String
  position  Int        @default(0)
  status    LrnStatus  @default(published)
  lessons   LrnLesson[]

  @@index([subjectId, band])
  @@map("ye_lrn_units")
  @@schema("ye")
}

model LrnLesson {
  id              Int          @id @default(autoincrement())
  unit            LrnUnit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId          Int
  titleAr         String
  titleEn         String
  descAr          String?
  descEn          String?
  videoUrl        String?
  videoType       LrnVideoType @default(youtube)
  durationMinutes Int          @default(8)
  position        Int          @default(0)
  status          LrnStatus    @default(published)
  isFreeSample    Boolean      @default(false)
  exercises        LrnExercise[]
  completions      LrnCompletion[]
  firstCompletions LrnFirstCompletion[]

  @@index([unitId])
  @@map("ye_lrn_lessons")
  @@schema("ye")
}

model LrnExercise {
  id            Int             @id @default(autoincrement())
  lesson        LrnLesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId      Int
  type          LrnExerciseType @default(multiple_choice)
  promptAr      String
  promptEn      String
  options       String[]
  correctAnswer String
  position      Int             @default(0)

  @@index([lessonId])
  @@map("ye_lrn_exercises")
  @@schema("ye")
}

/// Standalone kid profile for the learning platform (not tied to Student enrollment)
model LrnChild {
  id                Int             @id @default(autoincrement())
  family            Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId          Int
  name              String
  avatar            String          @default("⭐")
  band              LrnBand         @default(explorers)
  pin               String          // scrypt salt:hash
  xp                Int             @default(0)
  streak            Int             @default(0)
  lastActiveDate    String?         // ISO date YYYY-MM-DD
  badges            String[]        @default([])
  dailyLimitMinutes Int?
  createdAt         DateTime        @default(now())
  completions       LrnCompletion[]
  firstCompletions  LrnFirstCompletion[]

  @@index([familyId])
  @@map("ye_lrn_children")
  @@schema("ye")
}

model LrnCompletion {
  id               Int       @id @default(autoincrement())
  child            LrnChild  @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId          Int
  lesson           LrnLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId         Int
  score            Float     // 0-100
  timeSpentSeconds Int       @default(0)
  createdAt        DateTime  @default(now())

  @@index([childId, lessonId])
  @@map("ye_lrn_completions")
  @@schema("ye")
}

/// Durable first-completion claim — unique (childId, lessonId) ensures only
/// one row can be inserted; used atomically (createMany skipDuplicates in a
/// transaction) to determine whether XP/badges should be awarded.
model LrnFirstCompletion {
  id        Int       @id @default(autoincrement())
  child     LrnChild  @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId   Int
  lesson    LrnLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId  Int
  claimedAt DateTime  @default(now())

  @@unique([childId, lessonId])
  @@map("ye_lrn_first_completions")
  @@schema("ye")
}

// ————————————————————————— Rate Limit (durable) —————————————————————————

// Durable sliding-window rate-limit counters for public booking endpoints.
// Persisted in the DB (not process memory) so limits survive server restarts
// and apply across multiple instances.
model RateLimitHit {
  id  Int      @id @default(autoincrement())
  key String
  at  DateTime @default(now())

  @@index([key, at])
  @@map("ye_rate_limit_hits")
  @@schema("ye")
}
