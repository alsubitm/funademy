{
  "name": "@workspace/ye",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p $PORT",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p $PORT",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "next": "^15.3.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "prisma": "^6.5.0",
    "tailwindcss": "catalog:",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
