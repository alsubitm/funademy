{
  "name": "@workspace/ye",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p $PORT",
    "build": "prisma generate && pnpm run db:schema-sql && next build",
    "start": "next start -H 0.0.0.0 -p $PORT",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "bash scripts/guarded-db-push.sh",
    "db:push:unsafe": "prisma db push --skip-generate",
    "db:schema-sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/schema.sql && node -e \"const fs=require('fs');const p='prisma/schema.sql';fs.writeFileSync(p,fs.readFileSync(p,'utf8').trimEnd()+'\\n')\"",
    "db:legacy-migrate": "tsx scripts/migrate-ye-to-public.ts",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@replit/connectors-sdk": "^0.4.1",
    "next": "^15.5.28",
    "openai": "^6.27.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.7",
    "prisma": "^6.5.0",
    "tailwindcss": "catalog:",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
